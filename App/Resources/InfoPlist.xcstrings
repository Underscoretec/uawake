    "NSCameraUsageDescription": {
      "comment": "Privacy prompt text shown by macOS",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "uawake checks whether a camera is in use, to keep your Mac awake during calls. It never records or views video."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "comment": "Privacy prompt text shown by macOS",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "uawake checks which Bluetooth devices are connected, for rules that keep your Mac awake."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy prompt text shown by macOS",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "macOS shares the Wi-Fi network name only with apps that have Location access. uawake uses the name for rules and never reads where you are."
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "comment": "Privacy prompt text shown by macOS",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "macOS shares the Wi-Fi network name only with apps that have Location access. uawake uses the name for rules and never reads where you are."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Privacy prompt text shown by macOS",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "uawake checks whether a calendar event is in progress, for rules that keep your Mac awake. Events never leave your Mac."
          }
        }
      }
    }
