<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle. The feed is GitHub Pages (branch gh-pages); archives are GitHub Release assets.
	     The updater stays off while SUPublicEDKey is the placeholder (docs/RELEASING.md). -->
	<key>SUFeedURL</key>
	<string>https://underscoretec.github.io/uawake/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>REPLACE_WITH_EDDSA_PUBLIC_KEY</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.underscoretec.uawake</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>uawake</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
